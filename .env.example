# CasparCG Server Connection Settings (Default AMCP TCP Port 5250)
CASPARCG_HOST=127.0.0.1
CASPARCG_PORT=5250

# MySQL Database Connection Settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=casparcg_db

# Mock DB Fallback Mode (true = force mock data, false = use live MySQL when available)
USE_MOCK_DB=false
